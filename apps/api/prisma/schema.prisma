generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ORGANIZER
  ADMINISTRATOR
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum LostFoundKind {
  LOST
  FOUND
}

enum LostFoundStatus {
  OPEN
  RESOLVED
}

enum LostFoundCategory {
  ELECTRONICS
  ID_CARDS
  KEYS
  CLOTHING
  BAGS
  BOOKS
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  PENDING
  ACCEPTED
}

enum ReportTargetType {
  LISTING
  LOST_FOUND_POST
  EVENT
  USER
  MESSAGE
  FILE
}

enum ReportStatus {
  OPEN
  RESOLVED
  ACTIONED
  DISMISSED
}

model User {
  id              String     @id @default(cuid()) @map("_id")
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  role            Role       @default(STUDENT)
  status          UserStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  termsAcceptedAt DateTime?
  otpHash         String?
  otpExpiresAt    DateTime?

  profile            Profile?
  listings           Listing[]
  participants       Participant[]
  sentMessages       Message[]          @relation("MessageSender")
  lostFoundPosts     LostFoundPost[]
  organizedEvents    Event[]
  rsvps              Rsvp[]
  studyGroupsCreated StudyGroup[]
  studyGroups        StudyGroupMember[]
  reportsFiled       Report[]           @relation("ReportReporter")
  moderationActions  ModerationAction[] @relation("ModerationAdmin")

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([role, createdAt(sort: Desc), id(sort: Desc)])
}

model PendingRegistration {
  id              String    @id @default(cuid()) @map("_id")
  email           String    @unique
  firstName       String?
  lastName        String?
  passwordHash    String
  otpHash         String
  otpExpiresAt    DateTime
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
}

model Profile {
  userId      String   @id @map("_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  program     String?
  yearOfStudy Int?
  bio         String?
  avatarUrl   String?
  interests   String[]
}

model Category {
  id       String    @id @default(cuid()) @map("_id")
  name     String
  slug     String    @unique
  listings Listing[]
}

model Listing {
  id          String        @id @default(cuid()) @map("_id")
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  title       String
  description String
  priceCents  Int
  condition   String
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  archivedAt  DateTime?

  images        ListingImage[]
  conversations Conversation[]

  @@index([status])
  @@index([categoryId])
  @@index([priceCents])
  @@index([createdAt(sort: Desc)])
}

model ListingImage {
  id        String  @id @default(cuid()) @map("_id")
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model Conversation {
  id            String             @id @default(cuid()) @map("_id")
  type          ConversationType   @default(DIRECT)
  name          String?
  studyGroupId  String?
  status        ConversationStatus @default(PENDING)
  requestedById String?
  // DIRECT keys include their context: direct:<pair>, listing:<id>:<pair>, or event:<id>:<pair>.
  // Older DMs use a sorted "userA_userB" pair; GROUP uses "group:<studyGroupId>". Never null, so the
  // unique index also prevents duplicate DMs (MongoDB unique indexes treat nulls as equal).
  directKey     String             @unique
  lastMessage   LastMessage?
  listingId     String?
  listing       Listing?           @relation(fields: [listingId], references: [id])
  eventId       String?
  event         Event?             @relation(fields: [eventId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  participants Participant[]
  messages     Message[]

  @@index([updatedAt(sort: Desc)])
}

type LastMessage {
  text      String
  senderId  String
  createdAt DateTime
}

model Participant {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  blockedAt      DateTime?
  ignoredAt      DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  text           String
  attachments    Attachment[]
  clientId       String?
  createdAt      DateTime     @default(now())
  removedAt      DateTime?

  @@index([conversationId, createdAt(sort: Desc)])
}

type Attachment {
  url      String
  name     String
  mimeType String
  size     Int
}

model StudyGroup {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  courseCode  String
  description String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  members StudyGroupMember[]
}

model StudyGroupMember {
  id           String     @id @default(cuid()) @map("_id")
  studyGroupId String
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  joinedAt     DateTime   @default(now())

  @@unique([studyGroupId, userId])
  @@index([userId])
}

model LostFoundPost {
  id          String          @id @default(cuid()) @map("_id")
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])
  kind        LostFoundKind
  title       String
  description String
  // Nullable for reports created before categories existed; new posts require it in the API.
  category    LostFoundCategory? @default(OTHER)
  location    String
  occurredOn  DateTime
  imageUrl    String?
  status      LostFoundStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  removedAt   DateTime?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([category, createdAt(sort: Desc), id(sort: Desc)])
  @@index([occurredOn])
}

model Event {
  id          String      @id @default(cuid()) @map("_id")
  organizerId String
  organizer   User        @relation(fields: [organizerId], references: [id])
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  // Calendar date selected by the organizer; it can exist without an end time.
  endDate     String?
  location    String
  imageUrl    String?
  status      EventStatus @default(DRAFT)

  rsvps Rsvp[]
  conversations Conversation[]

  @@index([status, startsAt, id])
  @@index([organizerId, startsAt(sort: Desc), id(sort: Desc)])
}

model Rsvp {
  id          String   @id @default(cuid()) @map("_id")
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  respondedAt DateTime @default(now())

  @@unique([eventId, userId])
}

model Report {
  id         String           @id @default(cuid()) @map("_id")
  reporterId String
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  note       String?
  snapshot   Json?
  fileKey    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  moderationActions ModerationAction[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([reporterId, targetType, targetId, status])
}

model ModerationAction {
  id        String   @id @default(cuid()) @map("_id")
  adminId   String
  admin     User     @relation("ModerationAdmin", fields: [adminId], references: [id])
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  action    String
  note      String?
  createdAt DateTime @default(now())
}
