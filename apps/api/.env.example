# MongoDB Atlas connection string (free tier)
DATABASE_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/campushub?retryWrites=true&w=majority&appName=Cluster0"

# JWT signing secret — generate with `openssl rand -base64 32`
JWT_SECRET="change-me"

# Transactional email (Resend or SendGrid) — used for the Fanshawe email OTP
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="change-me"
EMAIL_FROM="CampusHub <no-reply@campushub.dev>"

# Only addresses on this domain may complete registration (NFR 1)
ALLOWED_EMAIL_DOMAIN="fanshaweonline.ca"

PORT=4000
