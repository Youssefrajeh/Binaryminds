# MongoDB connection string
DATABASE_URL=""

# JWT secret for signing tokens
JWT_SECRET=""

# Brevo HTTPS email API. EMAIL_FROM_ADDRESS must be a validated sender in Brevo.
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Only addresses on this domain may complete registration (NFR 1)
ALLOWED_EMAIL_DOMAIN="fanshaweonline.ca"

PORT=4000

# Optional: where replies to system emails go (defaults to the sending address)
EMAIL_REPLY_TO=""

# Public site URL; used for the logo image in emails (falls back to the first CLIENT_URL)
APP_URL=""
