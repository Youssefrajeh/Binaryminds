# MongoDB connection string
DATABASE_URL=""

# JWT secret for signing tokens
JWT_SECRET=""

# SMTP settings for sending emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Google OAuth credentials for sending email via Gmail API over HTTPS (preferred on hosts that block SMTP, e.g. Render free tier).
# Sends as SMTP_USER; needs a Google OAuth client with the gmail.send scope.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Brevo HTTPS email API (preferred on hosts that block SMTP, e.g. Render free tier)
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Only addresses on this domain may complete registration (NFR 1)
ALLOWED_EMAIL_DOMAIN="fanshaweonline.ca"

PORT=4000
