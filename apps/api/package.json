{
  "name": "@campushub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run build -w @campushub/web",
    "start": "node dist/index.js",
