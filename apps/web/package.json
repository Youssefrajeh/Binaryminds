{
  "name": "@campushub/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @campushub/shared",
    "prebuild": "npm run build -w @campushub/shared",
    "pretest": "npm run build -w @campushub/shared",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit && tsc -p cypress/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "cy:open": "node cypress/launch.mjs open",
    "cy:run": "node cypress/launch.mjs run"
  },
  "dependencies": {
    "@campushub/shared": "*",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.2.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
